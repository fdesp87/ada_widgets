with "gtkada";

library project Ada_Widgets is
   type Build_Mode is ("debug", "optimize", "extra_debug");
   Build : Build_Mode := external ("ADA_WIDGETS_BUILD", "optimize");

   for Library_Kind use "relocatable";
   for Library_Auto_Init use "true";
   for Object_Dir use "./obj";
   for Library_ALI_Dir use "./ali";
   for Library_Name use "ada_widgets";
   for Library_Dir use "./lib";
   for Languages use ("Ada");
   --  for Languages use ("Ada", "C");
   for Source_Dirs use ("./", "../glade_binding");
   for Library_Options use (
      "-lgladeui-2",
      "-lgtk-3",
      "-lgobject-2.0",
      "-lglib-2.0",
      "-Wl,--export-dynamic"
   );
   for Library_Interface use
     ("Ada_Widgets",
      "Ada_Widgets.Catalog",
      "Ada_Widgets.Date_Picker",
      "Ada_Widgets.Date_Picker.Editor",
      "Ada_Widgets.Date_Picker.Glade",
      "Ada_Widgets.Date_Picker.Implem",
      "Ada_Widgets.Date_Picker.Validation",
      "Ada_Widgets.Time_Picker",
      "Ada_Widgets.Time_Picker.Glade",
      "Ada_Widgets.Time_Picker.Implem",
      "Glib.Additions",

      -- Glade bindings that are part of the public API
      "Glade_Binding",
      "Glade_Binding.Editor_Property",
      "Glade_Binding.Properties",
      "Glade_Binding.Property_Definition",
      "Glade_Binding.Widget",
      "Glade_Binding.Widget_Adaptor"
     );

   -- Common system include directories treated as system headers (-isystem)
   -- to avoid third-party header warnings from Glade and GTK headers.
   System_Includes := (
      "-I/opt/GNAT/15.1.0-2/lib/gcc/x86_64-pc-linux-gnu/15.1.0/include/",
      "-isystem/usr/include/gtk-3.0",
      "-isystem/usr/include/glib-2.0",
      "-isystem/usr/lib/x86_64-linux-gnu/glib-2.0/include",
      "-isystem/usr/include/pango-1.0",
      "-isystem/usr/include/harfbuzz",
      "-isystem/usr/include/atk-1.0",
      "-isystem/usr/include/cairo",
      "-isystem/usr/include/gdk-pixbuf-2.0",
      "-isystem/usr/include/gio-unix-2.0",
      "-isystem/usr/include/freetype2",
      "-isystem/usr/include/libpng16",
      "-isystem/usr/include/libmount",
      "-isystem/usr/include/blkid",
      "-isystem/usr/include/fribidi",
      "-isystem/usr/include/pixman-1",
      "-isystem/usr/include/x86_64-linux-gnu",
      "-isystem/usr/include/webp",
      "-isystem/usr/include/at-spi2-atk/2.0",
      "-isystem/usr/include/at-spi-2.0",
      "-isystem/usr/include/dbus-1.0",
      "-isystem/usr/lib/x86_64-linux-gnu/dbus-1.0/include",
      "-isystem/usr/include/libgladeui-2.0",
      "-pthread"
   );

   package Compiler is
      defaults := (
           "-ffunction-sections",  -- function sections separated
           "-fdata-sections",      -- data sections separated
           "-gnat2022",      --  Ada 2022
           "-gnatX",         --  GNAT extensions
           "-gnatQ"          --  generate ALI even if illegalities
                  );
      warnings := (
--         "-gnatwe",  --  warnings and style checks are errors
           "-gnatwa",  --  all optional warnings
           "-gnatwC",  --  Suppress warnings on conditionals
           "-gnatwJ",  --  Disable warnings on obsolescent features
           "-gnatwM"   --  Disable warnings on modified but unreferenced variables
                   );
      style := (
           "-gnaty",         --  enable built-in style checks
           "-gnaty3",        --  Identation level
           "-gnatya",        --  Check attribute casing
           "-gnatyb",        --  Blanks not allowed at statement end
           "-gnatyc",        --  Check comments, double space
           "-gnatye",        --  Check end/exit labels
           "-gnatyf",        --  No form feeds or vertical tabs
           "-gnatyh",        --  No horizontal tabs
           "-gnatyi",        --  Check if-then layout
           "-gnatyk",        --  Check keyword casing
           "-gnatyl",        --  Check layout
           "-gnatyM120",     --  Set maximum line length
           "-gnatyn",        --  Check casing of entities in Standard
           "-gnatyp",        --  Check pragma casing
           "-gnatyr",        --  Check references
           "-gnatys",        --  Check separate specs
           "-gnatyS",        --  Check no statements after then/else
           "-gnatyt"         --  Check token spacing
               );
      case Build is
         when "debug" =>
            for Switches ("C") use ("-g", "-O0", "-fPIC") & System_Includes;
            for Default_Switches ("Ada") use defaults & warnings & style
             & (
           "-g",             --  debug
           "-O0",            --  optimization level 0
           "-fstack-check",  --  stack check
           "-gnata",         --  enable assettions
           "-gnateE"         --  generate extra info in exception msgs
               );
         when "extra_debug" =>
            for Switches ("C") use ("-g", "-O0", "-fPIC") & System_Includes;
            for Default_Switches ("Ada") use defaults & warnings & style
             & (
           "-v",             --  verbose
           "-g",             --  debug
           "-O0",            --  optimization level 0
           "-fstack-check",  --  stack check
           "-gnata",         --  enable assettions
           "-gnateE"         --  generate extra info in exception msgs
               );
         when "optimize" =>
            for Switches ("C") use ("-O2", "-fPIC") & System_Includes;
            for Default_Switches ("Ada") use defaults & warnings
             & (
            "-O2",           --  optimize level 2
            "-gnatn",        --  inline level 1
            "-gnatp",        --  suppress all checks
            "-gnateE"        --  generate extra info in exception msgs
               );
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-D100k");
   end Binder;

end Ada_Widgets;
